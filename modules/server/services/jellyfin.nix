# Jellyfin, movies and TV: https://jellyfin.<privateDomain>, over NetBird only.
# Lives on fox-red; the video sits on the Storage Box next to the music
# (/mnt/music, music.nix). Add the two libraries once in the web UI:
# /mnt/music/video/Movies and /mnt/music/video/TV.
#
# Everything is H.265 and the phone and laptop play it directly, so nothing
# here transcodes. Keep it that way: transcoding would swamp fox-red's CPU.
#
# New video comes in through the drop folder (~/drop/{Movies,TV},
# server/services/syncthing.nix), including fox-copper's encodes (`copper
# pull` on the laptop puts them there). This server holds no Filen login.
{ config, lib, pkgs, ... }:
let
  # Web UI colours from lib/palette.nix, laid over Jellyfin's built-in Dark
  # theme (the default; other themes only partly pick this up). Same rules
  # as the desktop: forest/teal/rust are fills behind fg text, *_text and
  # amber are for text on bg.
  c = (import ../../../lib/palette.nix).for "jellyfin";
  hex = name: "#${c.${name}}";
  # "37 92 43": the form MUI's *Channel variables take.
  channel = name:
    let h = c.${name}; byte = i: toString (lib.fromHexString (builtins.substring i 2 h));
    in "${byte 0} ${byte 2} ${byte 4}";
  rgba = name: alpha: "rgb(${channel name} / ${alpha})";

  css = ''
    /* fox-den palette, generated by jellyfin.nix. Edit there, not in the dashboard. */

    /* Dashboard and newer pages (MUI) */
    html[data-theme] {
      --jf-palette-background-default: ${hex "bg"};
      --jf-palette-background-defaultChannel: ${channel "bg"};
      --jf-palette-background-paper: ${hex "surf"};
      --jf-palette-background-paperChannel: ${channel "surf"};
      --jf-palette-AppBar-defaultBg: ${hex "surf"};
      --jf-palette-text-primary: ${hex "fg"};
      --jf-palette-text-secondary: ${hex "dim"};
      --jf-palette-divider: ${hex "line"};
      --jf-palette-primary-main: ${hex "forest_text"};
      --jf-palette-primary-mainChannel: ${channel "forest_text"};
      --jf-palette-primary-light: ${hex "forest_text"};
      --jf-palette-primary-dark: ${hex "forest"};
      --jf-palette-primary-contrastText: ${hex "bg"};
      --jf-palette-secondary-main: ${hex "teal_text"};
      --jf-palette-secondary-mainChannel: ${channel "teal_text"};
      --jf-palette-secondary-contrastText: ${hex "bg"};
      --jf-palette-error-main: ${hex "rust_text"};
      --jf-palette-error-mainChannel: ${channel "rust_text"};
      --jf-palette-warning-main: ${hex "amber"};
      --jf-palette-warning-mainChannel: ${channel "amber"};
      --jf-palette-success-main: ${hex "forest_text"};
      --jf-palette-success-mainChannel: ${channel "forest_text"};
      --jf-palette-info-main: ${hex "teal_text"};
      --jf-palette-info-mainChannel: ${channel "teal_text"};
    }

    /* Surfaces */
    html, .backgroundContainer, .dialog, .mainDrawer, .drawer-open,
    .nowPlayingContextMenu, .nowPlayingPlaylist, .ui-corner-all, .wizardStartForm,
    .noBackdropTransparency .detailPagePrimaryContainer,
    .noBackdropTransparency .detailPageSecondaryContainer,
    #bookPlayer, #comicsPlayer, #pdfPlayer, #dialogToc {
      background-color: ${hex "bg"};
    }
    .backgroundContainer.withBackdrop { background-color: ${rgba "bg" "0.88"}; }
    .skinHeader-withBackground, .appfooter, .playlistSectionButton, .paperList,
    .visualCardBox, .collapseContent, .infoBanner, .toast, .fab, .raised,
    .formDialogHeader:not(.formDialogHeader-clear),
    .formDialogFooter:not(.formDialogFooter-clear) {
      background-color: ${hex "surf"};
    }
    .layout-tv .formDialogFooter:not(.formDialogFooter-clear) { background-color: transparent; }
    .skinHeader.semiTransparent { background-color: ${rgba "bg" "0.5"}; }
    .detailRibbon { background: ${rgba "surf" "0.85"}; }
    .detailTableBodyRow-shaded:nth-child(2n) { background: ${hex "surf"}; }
    .fab:focus, .raised:focus { background: ${hex "line"}; }

    /* Text */
    html, .skinHeader, .toast, .appfooter, .fab, .raised, .infoBanner,
    .alphaPickerButton-selected, .emby-tab-button-active { color: ${hex "fg"}; }
    .secondaryText, .cardText-secondary, .fieldDescription, .listItem .secondary,
    .nowPlayingBarSecondaryText, .programSecondaryTitle, .guide-programNameCaret,
    .inputLabel, .inputLabelUnfocused, .textareaLabelUnfocused, .checkboxListLabel,
    .paperListLabel, .alphaPickerButton, .emby-tab-button, .guide-date-tab-button {
      color: ${hex "dim"};
    }
    ::selection { background: ${hex "forest"}; color: ${hex "fg"}; }

    /* Lines */
    .emby-collapsible-button { border-color: ${hex "line"}; }
    .actionsheetDivider { background: ${hex "line"}; }
    .listItem-border { border-color: ${hex "line"} !important; }
    .channelPrograms, .guide-channelHeaderCell, .programCell { border-color: ${hex "line"}; }
    .mediaInfoText { background: ${hex "line"}; color: ${hex "fg"}; }

    /* Inputs */
    .emby-input, .emby-textarea, .emby-select-withcolor {
      background: ${hex "surf"}; border-color: ${hex "line"};
    }
    .emby-select-withcolor option { background: ${hex "surf"}; }
    .emby-input:focus, .emby-textarea:focus { border-color: ${hex "forest_text"}; }
    .emby-select-withcolor:focus { border-color: ${hex "forest_text"} !important; }
    .inputLabelFocused, .selectLabelFocused, .textareaLabelFocused { color: ${hex "forest_text"}; }
    .emby-checkbox:checked + span + .checkboxOutline {
      background-color: ${hex "forest"}; border-color: ${hex "forest_text"};
    }
    .emby-checkbox:focus:not(:checked) + span + .checkboxOutline { border-color: ${hex "forest_text"}; }

    /* Accent fills: forest behind fg text, teal on hover/focus */
    .button-submit, .navMenuOption-selected, .selectionCommandsPanel,
    .emby-button.show-focus:focus, .emby-button.detailFloatingButton,
    .alphaPickerButton-tv:focus, .guide-date-tab-button.show-focus:focus,
    .emby-select-tv-withcolor:focus,
    .guide-channelHeaderCell:focus, .programCell:focus {
      background: ${hex "forest"} !important; color: ${hex "fg"} !important;
    }
    .button-submit:focus, .button-submit:hover { background: ${hex "teal"} !important; }
    .countIndicator, .playedIndicator, .mediaSourceIndicator, .fullSyncIndicator {
      background: ${hex "forest"}; color: ${hex "fg"};
    }
    .itemProgressBarForeground { background-color: ${hex "forest_text"}; }
    .navMenuOption:hover, .listItem:hover { background: ${hex "surf"}; }
    .listItem:focus { background: ${hex "line"}; }
    .programCell-active { background: ${hex "surf"} !important; }

    /* Accent text and outlines */
    .button-link, .button-flat:hover, .buttonActive, .metadataSidebarIcon,
    .upNextDialog-countdownText, .emby-tab-button:hover, .emby-tab-button.show-focus:focus,
    .guide-date-tab-button.emby-tab-button-active, .guide-date-tab-button:focus,
    .paper-icon-button-light.show-focus:focus, .playstatebutton-icon-played,
    #dialogToc .bookplayerButtonIcon:hover, #dialogToc .toc li a:hover {
      color: ${hex "forest_text"} !important;
    }
    .paper-icon-button-light:hover:not(:disabled), .paper-icon-button-light:active:not(:disabled) {
      background-color: ${rgba "forest" "0.45"}; color: ${hex "forest_text"};
    }
    .card:focus .cardBox.visualCardBox,
    .card:focus .cardBox:not(.visualCardBox) .cardScalable,
    .itemSelectionPanel { border-color: ${hex "forest_text"} !important; }
    .progressring-spiner { border-color: ${hex "forest_text"}; }

    /* Alerts */
    .button-delete { background: ${hex "rust"}; color: ${hex "fg"}; }
    .itemProgressBarForeground-recording { background-color: ${hex "rust_text"}; }
    .ratingbutton-icon-withrating { color: ${hex "rust_text"}; }
    .downloadbutton-icon-on, .downloadbutton-icon-complete { color: ${hex "teal_text"}; }

    /* Placeholder cards (no artwork) */
    .defaultCardBackground1 { background-color: ${hex "forest"}; }
    .defaultCardBackground2 { background-color: ${hex "teal"}; }
    .defaultCardBackground3 { background-color: ${hex "rust"}; }
    .defaultCardBackground4 { background-color: ${hex "surf"}; }
    .defaultCardBackground5 { background-color: ${hex "line"}; }

    /* Scrollbars */
    * { scrollbar-color: ${hex "line"} ${hex "bg"}; }
    ::-webkit-scrollbar-track-piece { background-color: ${hex "bg"}; }
    ::-webkit-scrollbar-thumb:horizontal, ::-webkit-scrollbar-thumb:vertical { background-color: ${hex "line"}; }
  '';

  branding = pkgs.writeText "jellyfin-branding.xml" ''
    <?xml version="1.0" encoding="utf-8"?>
    <BrandingOptions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <LoginDisclaimer />
      <CustomCss>${lib.escapeXML css}</CustomCss>
      <SplashscreenEnabled>false</SplashscreenEnabled>
    </BrandingOptions>
  '';
in
{
  services.jellyfin.enable = true;

  # Jellyfin reads branding.xml once at startup, so write it just before.
  # This replaces whatever was saved under Dashboard > Branding: change the
  # CSS above instead (a palette edit restarts Jellyfin on the next switch).
  systemd.services.jellyfin.preStart = ''
    install -m 0640 ${branding} ${config.services.jellyfin.configDir}/branding.xml
  '';

  # Reads the share as "other" (music.nix mounts it 0664/0775). Waits for the
  # mount so it never scans an empty directory and drops the library.
  systemd.services.jellyfin.unitConfig.RequiresMountsFor = "/mnt/music";

  # Nightly backup: users, watch history, libraries (root/), settings and
  # plugin configs. Left out: artwork and metadata (re-fetched by a library
  # scan), logs, and the live database, which is dumped instead.
  fox.server.backup = {
    paths = [ "/var/lib/jellyfin" ];
    exclude = [
      "/var/lib/jellyfin/metadata"
      "/var/lib/jellyfin/log"
      "/var/lib/jellyfin/data/*.db"
      "/var/lib/jellyfin/data/*.db-wal"
      "/var/lib/jellyfin/data/*.db-shm"
    ];
    sqlite = [ "/var/lib/jellyfin/data/jellyfin.db" ];
  };

  # Reached only through Caddy; 8096 stays closed in the firewall.
  fox.server.privateSites.jellyfin.upstream = "127.0.0.1:8096";
}
